{
  "manifest_version": 3,
  "name": "Viral Studio Flow Bridge",
  "version": "1.2.0",
  "description": "Bridges Viral Studio with Google Labs Flow Media API. Intercepts real reCAPTCHA tokens for reliable generation.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://labs.google/*"],
      "js": ["content-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://labs.google/*"],
      "js": ["content-relay.js"],
      "run_at": "document_start"
    }
  ]
}
