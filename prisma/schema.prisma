generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                      String       @id @default(uuid())
  email                   String
  full_name               String?
  username                String?      @unique
  phone                   String?
  avatar_url              String?
  is_subscribed           Boolean?     @default(false)
  subscribed_at           DateTime?
  subscription_expires_at DateTime?
  created_at              DateTime?    @default(now())
  
  characters              Character[]
  products                Product[]
  storyboards             Storyboard[]
  daily_usages            DailyUsage[]

  @@map("profiles")
}

model DailyUsage {
  id      String   @id @default(uuid())
  user_id String
  date    DateTime @db.Date @default(now())
  count   Int?     @default(0)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@map("daily_usage")
}

model Character {
  id            String       @id @default(uuid())
  user_id       String
  label_name    String
  anchor_phrase String
  anchor_hash   String
  image_urls    String[]     @default([])
  analysis      Json?
  created_at    DateTime?    @default(now())
  updated_at    DateTime?    @default(now())

  user        Profile      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  storyboards Storyboard[]

  @@map("characters")
}

model Product {
  id             String       @id @default(uuid())
  user_id        String
  product_name   String
  category       String?
  benefits       String[]     @default([])
  visual_desc    String?
  image_urls     String[]     @default([])
  detected_niche Json?
  created_at     DateTime?    @default(now())
  updated_at     DateTime?    @default(now())

  user        Profile      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  storyboards Storyboard[]

  @@map("products")
}

model Storyboard {
  id               String    @id @default(uuid())
  user_id          String
  title            String?
  character_id     String?
  product_id       String?
  selected_angle   Json?
  selected_persona Json?
  selected_niche   String?
  framework        String?
  scenes           Json?     @default("[]")
  status           String?   @default("draft")
  rating           Int?      @db.SmallInt
  created_at       DateTime? @default(now())

  user      Profile    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [character_id], references: [id], onDelete: SetNull)
  product   Product?   @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@map("storyboards")
}

model NichePattern {
  id                  String    @id @default(uuid())
  niche_id            String    @unique
  display_name        String
  angles              Json?     @default("[]")
  personas            Json?     @default("[]")
  content_matrix      Json?     @default("[]")
  competitor_patterns Json?
  version             Int?      @default(1)
  updated_at          DateTime? @default(now())

  @@map("niche_patterns")
}

model TrendingNiche {
  id         String    @id @default(uuid())
  week       String
  niches     Json?     @default("[]")
  updated_at DateTime? @default(now())

  @@map("trending_niches")
}
